# Installed by scripts/deploy.sh, which fills in the @…@ values.
[Unit]
Description=Discord server bot (@SERVICE@)
# Not on a server the bot was moved off (`deploy.sh migrate` writes that file).
ConditionPathExists=!@DIR@/MOVED-TO
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@DIR@
# Secrets are read by systemd, so the bot's user never needs access to .env
# (root-only). systemd reads it only on start: `deploy.sh secrets` restarts.
EnvironmentFile=@DIR@/.env
Environment=RUST_LOG=info
# This is the bot's own server: it runs with the bot's token, no sign-in.
Environment=BOT_LOCAL=1
# Commit and push the config changes the bot makes (lockfile after applies,
# /server edits, appointments, leavers, pulls from Discord).
Environment=CONFIG_AUTOSAVE=1
Environment=DATABASE_URL=sqlite:/var/lib/@SERVICE@/bot.db?mode=rwc
# Written about once a minute while Discord's gateway talks to the bot;
# `deploy.sh monitor-setup`'s timer checks it.
Environment=HEARTBEAT_FILE=/var/lib/@SERVICE@/heartbeat
# The monitor's URLs are for it alone.
UnsetEnvironment=MONITOR_WEBHOOK MONITOR_PING_URL
# The config is a git checkout the bot pulls and pushes with its own deploy key.
Environment="GIT_SSH_COMMAND=ssh -F /dev/null -i @DIR@/.ssh/deploy_key -o UserKnownHostsFile=@DIR@/.ssh/known_hosts -o IdentitiesOnly=yes"
StateDirectory=@SERVICE@
# The database (join answers, profiles, message log) is for the bot's user alone.
StateDirectoryMode=0700
UMask=0077
# One config per unit; `deploy.sh revoke` runs `fed revoke` with these settings.
ExecStart=@DIR@/current/bot run --config @DIR@/config
# Always: the bot also stops cleanly when Discord's gateway ends the connection.
Restart=always
RestartSec=5

# Sandbox: read-only system; writable only where the bot keeps state.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=@DIR@/config

[Install]
WantedBy=multi-user.target
