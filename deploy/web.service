# The web UI. Installed by scripts/deploy.sh when WEB_URL is set; published to the tailnet with `tailscale serve`.
[Unit]
Description=Discord server bot web UI (@SERVICE@)
# Not on a server the bot was moved off (`deploy.sh migrate` writes that file).
ConditionPathExists=!@DIR@/MOVED-TO
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@DIR@
# Secrets are read by systemd, so the bot's user never needs access to .env.
EnvironmentFile=@DIR@/.env
# The web UI doesn't need the bot's partner-sync key or the Tailscale API key
# (it also drops partner webhooks named in federation.toml when it starts).
UnsetEnvironment=FED_SIGNING_KEY TAILSCALE_API_KEY
Environment=RUST_LOG=info
# This is the bot's own server: it runs with the bot's token, no sign-in.
Environment=BOT_LOCAL=1
Environment=WEB_URL=@WEB_URL@
# Commit and push the config changes made here (dashboard and CLI edits,
# applies and their lockfile).
Environment=CONFIG_AUTOSAVE=1
Environment=DATABASE_URL=sqlite:/var/lib/@SERVICE@/bot.db?mode=rwc
# The config is a git checkout the bot pulls and pushes with its own deploy key.
Environment="GIT_SSH_COMMAND=ssh -F /dev/null -i @DIR@/.ssh/deploy_key -o UserKnownHostsFile=@DIR@/.ssh/known_hosts -o IdentitiesOnly=yes"
StateDirectory=@SERVICE@
# The database (join answers, profiles, message log) is for the bot's user alone.
StateDirectoryMode=0700
UMask=0077
ExecStart=@DIR@/current/bot web --addr 127.0.0.1:@WEB_PORT@ --config @DIR@/config
Restart=on-failure
RestartSec=5

# Sandbox: read-only system; writable only where the bot keeps state.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=@DIR@/config

[Install]
WantedBy=multi-user.target
